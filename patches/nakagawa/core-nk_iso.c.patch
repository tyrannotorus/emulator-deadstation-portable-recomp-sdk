+/* bytes of the image at pos: the plain file's, or the CHD's sectors */
+static size_t nk_iso_reader_pread(NkIsoReader *reader, uint64_t pos, void *dst, size_t bytes) {
+#ifdef NK_ISO_CHD
+    if (reader->chd) {
+        size_t done = 0;
+        uint8_t *out = (uint8_t *)dst;
+        while (done < bytes && pos < reader->file_size) {
+            const uint64_t sector = pos / SECTOR_SIZE;
+            const uint32_t within = (uint32_t)(pos % SECTOR_SIZE);
+            const uint32_t hunk = (uint32_t)(sector / reader->chd_per_hunk);
+            if (hunk != reader->chd_loaded) {
+                if (chd_read(reader->chd, hunk, reader->chd_hunk) != CHDERR_NONE) return done;
+                reader->chd_loaded = hunk;
+            }
+            size_t n = SECTOR_SIZE - within;
+            if (n > bytes - done) n = bytes - done;
+            memcpy(out + done, reader->chd_hunk + (sector % reader->chd_per_hunk) * reader->chd_unit + reader->chd_data + within, n);
+            done += n;
+            pos += n;
+        }
+        return done;
+    }
+#endif
+    if (nk_iso_fseek64(reader->f, (int64_t)pos, SEEK_SET) != 0) return 0;
+    return fread(dst, 1, bytes, reader->f);
+}
+
+#ifdef NK_ISO_CHD
+/* the CHD's geometry: a CD-type's track (its data offset in each frame) or a DVD-type's units; 0 if neither */
+static int nk_iso_chd_open(NkIsoReader *reader, const char *path) {
+    if (chd_open(path, CHD_OPEN_READ, NULL, &reader->chd) != CHDERR_NONE) return 0;
+    const chd_header *h = chd_get_header(reader->chd);
+    char meta[256];
+    uint32_t len = 0;
+    if (chd_get_metadata(reader->chd, CDROM_TRACK_METADATA2_TAG, 0, meta, sizeof(meta) - 1, &len, NULL, NULL) == CHDERR_NONE) {
+        meta[len < sizeof(meta) ? len : sizeof(meta) - 1] = '\0';
+        int track = 0, frames = 0;
+        char type[32] = "";
+        if (sscanf(meta, "TRACK:%d TYPE:%31s SUBTYPE:%*s FRAMES:%d", &track, type, &frames) != 3 || frames <= 0) return 0;
+        if (strcmp(type, "MODE1") == 0) reader->chd_data = 0;
+        else if (strcmp(type, "MODE1_RAW") == 0) reader->chd_data = 16;
+        else return 0;
+        reader->file_size = (uint64_t)frames * SECTOR_SIZE;
+    } else {
+        if (h->unitbytes != SECTOR_SIZE) return 0;
+        reader->chd_data = 0;
+        reader->file_size = h->logicalbytes;
+    }
+    reader->chd_unit = h->unitbytes;
+    reader->chd_per_hunk = h->hunkbytes / h->unitbytes;
+    reader->chd_hunk = (uint8_t *)malloc(h->hunkbytes);
+    reader->chd_loaded = UINT32_MAX;
+    return reader->chd_hunk != NULL && reader->chd_per_hunk > 0;
+}
+#endif
