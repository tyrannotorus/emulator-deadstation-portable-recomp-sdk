+#ifdef SR_GE_NATIVE
+/* a game function called from an HLE call, on the calling thread: entry(a0, a1, a2) on that thread's
+ * stack below its frame, its registers restored after (a library's handler a PSP calls from its own thread: ad hoc events). 0, or
+ * -1 when the call went fatal. */
+int sched_call_guest_from_hle(uint32_t entry, uint32_t a0, uint32_t a1, uint32_t a2) {
+    if (!s_cpu || !entry) return -1;
+    CpuState save;
+    memcpy(&save, s_cpu, sizeof(CpuState));
+    s_cpu->r[29] = (save.r[29] - 0x400u) & ~0xFu;
+    s_cpu->r[28] = s_gp;
+    s_cpu->r[4] = a0;
+    s_cpu->r[5] = a1;
+    s_cpu->r[6] = a2;
+    s_cpu->r[31] = SR_HOST_RETURN_PC;
+    s_cpu->pc = entry;
+    uint32_t fatal_target = 0u;
+    const int fatal = sched_dispatch_interrupt_guest(s_cpu, entry, "an HLE call's handler", &fatal_target);
+    if (fatal) {
+        fprintf(stderr, "sched: a handler called from an HLE call went fatal (entry 0x%08x, target 0x%08x)\n", entry, fatal_target);
+        return -1;
+    }
+    memcpy(s_cpu, &save, sizeof(CpuState));
+    return 0;
+}
+#endif
