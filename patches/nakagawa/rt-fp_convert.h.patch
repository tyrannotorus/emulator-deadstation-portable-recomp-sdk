+#if defined(SR_FPU_NATIVE) && defined(__aarch64__)
+/* The PSP's float-to-word conversions are AArch64's own: fcvtns/fcvtzs/fcvtps/fcvtms
+ * round as round.w/trunc.w/ceil.w/floor.w do and saturate as the PSP does (an infinity to INT32_MAX or INT32_MIN); only a NaN
+ * differs (0 on the host, INT32_MAX on the PSP), chosen first. One instruction, not a software decode through ldexp. */
+static inline uint32_t sr_native_to_word(float x, unsigned mode) {
+    if (x != x) return 0x7fffffffu;
+    switch (mode & 3u) {
+        case SR_FP_ROUND_TO_ZERO:  return (uint32_t)vcvts_s32_f32(x);
+        case SR_FP_ROUND_POSITIVE: return (uint32_t)vcvtps_s32_f32(x);
+        case SR_FP_ROUND_NEGATIVE: return (uint32_t)vcvtms_s32_f32(x);
+        default:                   return (uint32_t)vcvtns_s32_f32(x);
+    }
+}
+static inline uint32_t sr_fpu_to_word(float x, uint32_t funct, uint32_t fcr31) {
+    switch (funct) {
+        case 0x0cu: return sr_native_to_word(x, SR_FP_ROUND_NEAREST_EVEN);
+        case 0x0du: return sr_native_to_word(x, SR_FP_ROUND_TO_ZERO);
+        case 0x0eu: return sr_native_to_word(x, SR_FP_ROUND_POSITIVE);
+        case 0x0fu: return sr_native_to_word(x, SR_FP_ROUND_NEGATIVE);
+        case 0x24u: return sr_native_to_word(x, fcr31 & 3u);
+        default:    return sr_native_to_word(x, SR_FP_ROUND_NEAREST_EVEN);
+    }
+}
+/* the scale is a power of two: exact in float up to an overflow, which saturates as the PSP's does */
+static inline uint32_t sr_vfpu_to_word(float x, unsigned mode, unsigned scale) {
+    return sr_native_to_word(x * (float)(1u << (scale & 31u)), mode);
+}
+#else
 /* funct is the COP1 S-format function field. cvt.w.s uses fcr31[1:0]. */
 static inline uint32_t sr_fpu_to_word(float x, uint32_t funct, uint32_t fcr31) {
     const uint32_t bits = sr_float_bits(x);
@@ -154,6 +185,7 @@ static inline uint32_t sr_vfpu_to_word(float x, unsigned mode, unsigned scale) {
         ldexp(sr_finite_float_to_double(bits), (int)(scale & 31u)), mode
     );
 }
+#endif  /* SR_FPU_NATIVE && __aarch64__ */
 
