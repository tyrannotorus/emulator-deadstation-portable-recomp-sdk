+static inline float sr_fpu_add_s(float a, float b, uint32_t fcr31) { (void)fcr31; return a + b; }
+static inline float sr_fpu_sub_s(float a, float b, uint32_t fcr31) { (void)fcr31; return a - b; }
+static inline float sr_fpu_mul_s(float a, float b, uint32_t fcr31) { (void)fcr31; return a * b; }
+static inline float sr_fpu_div_s(float a, float b, uint32_t fcr31) { (void)fcr31; return a / b; }
+static inline float sr_fpu_cvt_s_w(int32_t value, uint32_t fcr31) { (void)fcr31; return (float)value; }
+static inline unsigned sr_fpu_condition_s(unsigned condition, uint32_t a_bits, uint32_t b_bits) {
+    float a, b;
+    memcpy(&a, &a_bits, sizeof a);
+    memcpy(&b, &b_bits, sizeof b);
+    const unsigned unordered = a != a || b != b;
+    return (unordered && (condition & 1u)) || (a == b && (condition & 2u)) || (a < b && (condition & 4u));
+}
+#else
 static inline float sr_fpu_add_s(float a, float b, uint32_t fcr31) {
     volatile float va = a;
     volatile float vb = b;
@@ -488,6 +536,8 @@ static inline unsigned sr_fpu_condition_s(unsigned condition, uint32_t a_bits,
            (less && (condition & 4u));
 }
 
+#endif  /* SR_FPU_NATIVE */
