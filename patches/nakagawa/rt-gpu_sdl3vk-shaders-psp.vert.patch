diff --git a/src/rt/gpu_sdl3vk/shaders/psp.vert b/src/rt/gpu_sdl3vk/shaders/psp.vert
index cf777238..0009706e 100644
--- a/src/rt/gpu_sdl3vk/shaders/psp.vert
+++ b/src/rt/gpu_sdl3vk/shaders/psp.vert
@@ -17,24 +17,30 @@ layout(location = 2) in float in_fog;   /* per-vertex fog factor, 1 = no fog */
 layout(location = 3) in vec4 in_color;  /* UNORM8 RGBA */
 layout(location = 4) in vec4 in_box;    /* edge clamp range (u0, v0, u1, v1); u0 > u1 or v0 > v1: free */
 
-layout(location = 0) noperspective out vec2  v_uv;
-layout(location = 1) noperspective out float v_rw;
+layout(location = 0) out vec2  v_uv;      /* w = 1 here: perspective and screen-linear agree */
+layout(location = 1) out float v_rw;
 layout(location = 2) noperspective out float v_fog;
 layout(location = 3) noperspective out vec4  v_color;
 layout(location = 4) flat out vec4 v_uvbox;
+layout(location = 5) flat out vec4 v_color_flat;
 
 /* No contraction of y * (1/136) - 1 into a fused multiply-add: psp_tnl.vert computes the same
  * position and has to round it the same way on every driver (#318). */
 precise gl_Position;
+/* Vert+: every target has k_vpad rows of picture above and below the guest's 272; its
+ * 272 + 2 * k_vpad rows span NDC y [-1, 1] (k_yscale = 2 / (272 + 2 * k_vpad)) */
+layout(constant_id = 10) const float k_vpad = 0.0;
+layout(constant_id = 11) const float k_yscale = 1.0 / 136.0;
 
 void main() {
     gl_Position = vec4(in_pos.x * (1.0 / 256.0) - 1.0,
-                       in_pos.y * (1.0 / 136.0) - 1.0,
+                       (in_pos.y + k_vpad) * k_yscale - 1.0,
                        in_pos.z * (1.0 / 65535.0),
                        1.0);
     v_uv    = in_uv;
     v_rw    = in_pos.w;
     v_fog   = in_fog;
     v_color = in_color;
+    v_color_flat = in_color;
     v_uvbox = in_box;
 }
