+/* sceIoChstat's size and times: a regular file truncated or extended to `size` (when set_size),
+ * its access and modification times (when set_atime / set_mtime: seconds since 1970 UTC). Opened as sr_cd_set_mode opens it:
+ * relative to the verified parent, never through a link, and only a regular file or a directory (times only) is touched. */
+static inline sr_cd_status sr_cd_set_times_size(const sr_cd_root *root, const char *rel, int set_size, uint64_t size,
+                                                int set_atime, int64_t atime, int set_mtime, int64_t mtime) {
+    char parent_rel[SR_CD_REL_MAX], leaf[SR_CD_NAME_MAX];
+    if (!root || root->fd < 0) return SR_CD_NOT_CONTAINED;
+    if (!sr_cd_rel_is_acceptable(rel) ||
+        !sr_cd_rel_split(rel, parent_rel, sizeof(parent_rel), leaf, sizeof(leaf)))
+        return SR_CD_INVALID_PATH;
+    int parent_fd = -1;
+    sr_cd_status status = sr_cd__at_walk(root->fd, parent_rel, &parent_fd);
+    if (status != SR_CD_OK) return status;
+    int fd = openat(parent_fd, leaf, (set_size ? O_WRONLY : O_RDONLY) | O_NOFOLLOW | O_CLOEXEC | O_NONBLOCK);
+    if (fd < 0) {
+        status = sr_cd__at_open_fail();
+        close(parent_fd);
+        return status;
+    }
+    struct stat info;
+    status = SR_CD_OK;
+    if (fstat(fd, &info) != 0)
+        status = SR_CD_IO_ERROR;
+    else if (!S_ISREG(info.st_mode) && !((info.st_mode & S_IFMT) == S_IFDIR && !set_size))
+        status = SR_CD_NOT_CONTAINED;
+    if (status == SR_CD_OK && set_size && ftruncate(fd, (off_t)size) != 0)
+        status = SR_CD_IO_ERROR;
+    if (status == SR_CD_OK && (set_atime || set_mtime)) {
+        struct timespec ts[2];
+        ts[0].tv_sec = (time_t)atime; ts[0].tv_nsec = set_atime ? 0 : UTIME_OMIT;
+        ts[1].tv_sec = (time_t)mtime; ts[1].tv_nsec = set_mtime ? 0 : UTIME_OMIT;
+        if (futimens(fd, ts) != 0) status = SR_CD_IO_ERROR;
+    }
+    close(fd);
+    close(parent_fd);
+    return status;
+}
