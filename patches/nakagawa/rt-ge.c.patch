+        const uint32_t n = !s_sent_any ? (uint32_t)sizeof ge_live.clutram : (s_clut_unsent + 15u) & ~15u;
+        if (n) {
+            uint32_t *c = split_reserve(K_CLUT, (uint32_t)sizeof(uint32_t) + n);
+            c[0] = n;
+            memcpy(c + 1, ge_live.clutram, n);
+        }
+        s_clut_unsent = 0;
+        s_sent_clut = clut;
+    }
+    const uint8_t *g = (const uint8_t *)&ge_live;
+    uint8_t *sh = (uint8_t *)&s_shadow;
