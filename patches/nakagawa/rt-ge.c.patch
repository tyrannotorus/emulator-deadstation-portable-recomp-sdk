+ * the PRIM's bound fails the corner test, each vertex's position is transformed (skinned) once through one matrix and a triangle
+ * is left out when a vertex is past the guard band or non-finite, when all are behind the eye, outside the depth range (depth
+ * clip off: any; on: all on one side), or in front with one at w <= NEAR_W (PPSSPP Clipper::ProcessTriangle, as
+ * draw_prim_xform_triangles decides); one crossing the near plane is the GPU's to clip. No CPU transform, lighting, clipping or
+ * rasterizing, and no CPU path: a PRIM the backend can't take is said once, loudly.
+ * The vertices handed over are the range the indices name, as the guest stored them (indices relative to its first vertex): no
+ * per-reference map. Decoded records only for a morphing PRIM or a range not in one host span. */
+enum { TV_NF = 1, TV_OOR = 2, TV_ZP = 4, TV_ZN = 8, TV_WNEG = 16, TV_BEHIND = 32, TV_WLOW = 64 };
+
+static inline void tnl_raw_pos(const uint8_t *p, int fmt, float o[3]) {
+    if (fmt == 3) { memcpy(o, p, 12); return; }
+    if (fmt == 2) { int16_t q[3]; memcpy(q, p, 6); for (int k = 0; k < 3; k++) o[k] = q[k] * (1.0f / 32768.0f); return; }
+    for (int k = 0; k < 3; k++) o[k] = (float)((const int8_t *)p)[k] * (1.0f / 128.0f);
+}
+static inline void tnl_raw_weights(const uint8_t *p, int fmt, int n, float w[8]) {
+    if (fmt == 3) { memcpy(w, p, 4u * (uint32_t)n); return; }
+    if (fmt == 2) { uint16_t q[8]; memcpy(q, p, 2u * (uint32_t)n); for (int k = 0; k < n; k++) w[k] = q[k] * (1.0f / 32768.0f); return; }
+    for (int k = 0; k < n; k++) w[k] = p[k] * (1.0f / 128.0f);
+}
+/* a model position's PSP acceptance flags (transform_model_vtx_clip's), skinned by w when the format has weights */
+static uint8_t tnl_vertex_flags(const float m[16], const float vp[6], const float p[3], const float *w, int wn) {
+    float x = p[0], y = p[1], z = p[2];
+    if (wn) {
+        float sx = 0.0f, sy = 0.0f, sz = 0.0f;
+        for (int b = 0; b < wn; b++) {
+            const float *bm = ge.bone + 12 * b;
+            sx += w[b] * (bm[0] * p[0] + bm[3] * p[1] + bm[6] * p[2] + bm[9]);
+            sy += w[b] * (bm[1] * p[0] + bm[4] * p[1] + bm[7] * p[2] + bm[10]);
+            sz += w[b] * (bm[2] * p[0] + bm[5] * p[1] + bm[8] * p[2] + bm[11]);
+        }
+        x = sx; y = sy; z = sz;
+    }
+    const float cx = m[0] * x + m[4] * y + m[8] * z + m[12], cy = m[1] * x + m[5] * y + m[9] * z + m[13];
+    const float cz = m[2] * x + m[6] * y + m[10] * z + m[14], cw = m[3] * x + m[7] * y + m[11] * z + m[15];
+    uint8_t f = 0;
+    if (!(isfinite(cx) && isfinite(cy) && isfinite(cz) && isfinite(cw))) return TV_NF;
+    const float iw = 1.0f / cw;   /* one reciprocal, not four divisions */
+    const float zw = cz * iw;
+    if (zw >= 1.000030517578125f) f |= TV_ZP;
+    else if (-zw >= 1.000030517578125f) f |= TV_ZN;
+    const float sx = cx * vp[0] * iw + vp[3], sy = cy * vp[1] * iw + vp[4], sz = cz * vp[2] * iw + vp[5];
+    if (!(isfinite(sx) && isfinite(sy) && isfinite(sz))) f |= TV_NF;
+    const float SB = 4095.0f + 15.5f / 16.0f;
+    if (ge.depth_clip) {
+        if (cz > -cw && (sx >= SB || sy >= SB || sx < 0.0f || sy < 0.0f)) f |= TV_OOR;
+    } else if (sx > SB || sy >= SB || sx < 0.0f || sy < 0.0f || sz < 0.0f || sz >= 65536.0f) {
+        f |= TV_OOR;
+    }
+    if (cw < 0.0f) f |= TV_WNEG;
+    if (cz + cw < 0.0f) f |= TV_BEHIND;
+    if (!(cw > NEAR_W)) f |= TV_WLOW;
+    return f;
+}
+/* a triangle the PSP leaves out, from its vertices' flags: any (f) and all (g) */
+static int tnl_triangle_dropped(unsigned f, unsigned g) {
+    if (f & (TV_NF | TV_OOR)) return 1;
+    if (g & TV_WNEG) return 1;
+    if (!ge.depth_clip && (f & (TV_ZP | TV_ZN))) return 1;
+    if ((g & TV_ZP) || (g & TV_ZN)) return 1;
+    if (!(f & TV_BEHIND)) return (f & TV_WLOW) != 0;
+    return (g & TV_BEHIND) != 0;
+}
+
+/* the T&L records' ids, from one counter: a moved copy of a record gets its own */
+static uint32_t tnl_next_params_id(void) {
+    static uint32_t ids;
+    if (++ids == 0u) ids = 1u;
+    return ids;
+}
+/* the record: built again only when the GE state, the vertex type or the vertex source changed (here
+ * for ge_tnl_try_prim and ge_tnl_try_patch alike: raw_mode 0, the GeTnlVtx records ge.c decoded) */
+static GeTnlParams s_params;
+static uint32_t s_params_serial = 0xFFFFFFFFu, s_params_vtype, s_params_id;
+static int s_params_raw = -1;
+static GeTnlParams *tnl_params_current(const VFmt *vf, int raw_mode, int wn, uint32_t stride) {
+    GeTnlParams *const pp = &s_params;
+    if (s_params_serial != s_ge_state_serial || s_params_vtype != ge.vtype || s_params_raw != raw_mode) {
+    GeTnlParams params;
+    tnl_params(vf, &params);
+    {
+        const uint32_t K = 0xFFu;
+        uint32_t po, no, to, co, pf, nf, tf, cf, wo, wf, wnn, st;
+        if (raw_mode) {
+            po = (uint32_t)vf->pos_off; pf = (uint32_t)vf->pos_fmt;
+            no = vf->nrm_off >= 0 ? (uint32_t)vf->nrm_off : K; nf = (uint32_t)vf->nrm_fmt;
+            to = vf->tc_off >= 0 ? (uint32_t)vf->tc_off : K;   tf = (uint32_t)vf->tc_fmt;
+            co = vf->col_off >= 0 ? (uint32_t)vf->col_off : K; cf = (uint32_t)vf->col_fmt;
+            wo = wn ? (uint32_t)vf->w_off : 0u; wf = (uint32_t)vf->w_fmt; wnn = (uint32_t)wn;
+            st = stride;
+        } else {
+            po = (uint32_t)offsetof(GeTnlVtx, x); pf = 3u; no = (uint32_t)offsetof(GeTnlVtx, nx); nf = 3u;
+            to = (uint32_t)offsetof(GeTnlVtx, u); tf = 3u; co = (uint32_t)offsetof(GeTnlVtx, rgba); cf = 7u;
+            wo = (uint32_t)offsetof(GeTnlVtx, w); wf = 3u; wnn = (uint32_t)wn; st = (uint32_t)sizeof(GeTnlVtx);
+        }
+        params.vfmt[0] = (po & K) | ((no & K) << 8) | ((to & K) << 16) | ((co & K) << 24);
+        params.vfmt[1] = (pf & 15u) | ((nf & 15u) << 4) | ((tf & 15u) << 8) | ((cf & 15u) << 12) | ((wf & 15u) << 16) | ((wnn & 15u) << 20);
+        params.vfmt[2] = (wo & K) | ((st & 0xFFFFu) << 8);
+        uint32_t ar = 255, ag = 255, ab = 255, aa = 255;
+        if (ge.material_set || ge.material_alpha_set) {
+            if (ge.material_set) { ar = ge.material & 0xFF; ag = (ge.material >> 8) & 0xFF; ab = (ge.material >> 16) & 0xFF; }
+            if (ge.material_alpha_set) aa = (uint32_t)ge.material_alpha & 0xFF;
+        }
+        params.absent_color = ar | (ag << 8) | (ab << 16) | (aa << 24);
+    }
+    s_params_serial = s_ge_state_serial;
+    s_params_vtype = ge.vtype;
+    s_params_raw = raw_mode;
+    /* a new id only for a record that differs: the renderer then reuses what it staged without comparing */
+    if (s_params_id == 0u || memcmp(pp, &params, sizeof params) != 0) {
+        *pp = params;
+        s_params_id = tnl_next_params_id();
+    }
+    }
+    return pp;
+}
+
+#ifdef SR_GE_NATIVE
+/* the module's hook (ge_gpu.c's, which calls it for 2D sprites and triangles); tnl: a 2D T&L PRIM, its uv unknown */
+typedef struct { uint32_t tex_addr; int tex_enable; int through; float x0, y0, x1, y1; float dy; int skip;
+                 float u0, v0, u1, v1; int tex_w, tex_h; int extend; int tnl; } SdkSpriteDraw;
+void sdk_sprite_draw(SdkSpriteDraw *d) __attribute__((weak));
+#endif
+
+static int ge_tnl_try_prim(int type, int count, const VFmt *vf, uint32_t vbase, uint32_t ibase, int idxfmt) {
+    if (!s_gpu || !s_gpu->tnl_prim || !tnl_enabled() || count < 3 || s_wide_d) return 0;
+    if (!tnl_state_ok(type, vf)) { s_tnl_cpu++; return 0; }
+    static uint32_t *s_tnl_ref, *s_tnl_off;
+    static uint8_t *s_tnl_vfl;
+    static uint32_t s_tnl_ref_cap, s_tnl_off_cap, s_tnl_vfl_cap;
+    const uint32_t ntri = type == 3 ? (uint32_t)(count / 3) : (uint32_t)(count - 2);
+    if (!tnl_grow((void **)&s_tnl_ref, &s_tnl_ref_cap, (uint32_t)count, sizeof(uint32_t)) ||
+        !tnl_grow((void **)&s_tnl_tri, &s_tnl_tri_cap, ntri * 3u, sizeof(uint32_t))) {
+        fprintf(stderr, "ge: GPU T&L: out of memory for a PRIM of %d vertices\n", count);
+        return 1;
+    }
+    /* 1. the vertex range the references name, each reference relative to its first vertex */
+    uint32_t minv = 0, maxv = (uint32_t)count - 1u;
+    if (idxfmt) {
+        const uint8_t *ip = idxfmt == 1 || idxfmt == 2 ? ge_ram_span(ibase, (uint32_t)count << (idxfmt - 1)) : NULL;
+        minv = UINT32_MAX;
+        maxv = 0;
+        for (int i = 0; i < count; i++) {
+            uint32_t vi;
+            if (ip && idxfmt == 1) vi = ip[i];
+            else if (ip) { uint16_t v16; memcpy(&v16, ip + 2 * i, 2); vi = v16; }
+            else vi = index_value(ibase, idxfmt, i) & 0xFFFFu;
+            s_tnl_ref[i] = vi;
+            if (vi < minv) minv = vi;
+            if (vi > maxv) maxv = vi;
+        }
+        for (int i = 0; i < count; i++) s_tnl_ref[i] -= minv;
+    } else {
+        for (int i = 0; i < count; i++) s_tnl_ref[i] = (uint32_t)i;
+    }
+    const uint32_t nv = maxv - minv + 1u, stride = (uint32_t)vf->stride;
+    if (!tnl_grow((void **)&s_tnl_off, &s_tnl_off_cap, nv, sizeof(uint32_t)) ||
+        !tnl_grow((void **)&s_tnl_vfl, &s_tnl_vfl_cap, nv, 1u) ||
+        !tnl_grow((void **)&s_tnl_refs, &s_tnl_refs_cap, nv, sizeof(GeTnlVtx))) {
+        fprintf(stderr, "ge: GPU T&L: out of memory for a PRIM of %u vertices\n", nv);
+        return 1;
+    }
+    /* 2. the bytes: the guest's own (one host span, RAM or the plain VRAM view), or records decoded here (a morphing PRIM, a
+     *    range that isn't one span) */
+    const uint32_t va0 = vbase + minv * stride;
+    const uint8_t *vb = NULL;
+    if (vf->morph_n <= 1) {
+        vb = ge_ram_span(va0, nv * stride);
+        if (!vb) {
+            const uint32_t vo = SR_PHYS(va0) - 0x04000000u;
+            if (vo < 0x00200000u && vo + nv * stride <= 0x00200000u) vb = SR_HOST_LINEAR(va0);
+        }
+    }
+    const int raw_mode = vb != NULL;
+    if (!raw_mode) {
+        for (uint32_t u = 0; u < nv; u++) {
+            GeTnlVtx *o = &s_tnl_refs[u];
+            memset(o, 0, sizeof(*o));
+            const uint32_t a = va0 + u * stride;
+            int r, g, b, al;
+            vtx_linear_begin(a, vf);
+            read_pos(a, vf, &o->x, &o->y, &o->z);
+            read_nrm(a, vf, &o->nx, &o->ny, &o->nz);
+            read_tc(a, vf, &o->u, &o->v);
+            read_color(a, vf, &r, &g, &b, &al);
+            o->rgba = (uint32_t)(r & 0xFF) | ((uint32_t)(g & 0xFF) << 8) | ((uint32_t)(b & 0xFF) << 16) | ((uint32_t)(al & 0xFF) << 24);
+            if (vf->w_n) read_weights(a, vf, o->w);
+            vtx_linear_end();
+        }
+    }
+    /* 3-4. The PSP's triangle drops are psp_tnl.vert's, vertex by vertex, as PPSSPP's
+     *      hardware T&L decides them (a vertex the PSP leaves out is NaN there and the GPU drops every triangle it is in; one wholly
+     *      behind the eye, beyond the depth range or at w < 0 the GPU clips away): no bound of the positions and weights, no corner
+     *      test and no flags per vertex here. The PRIM's pixels: within the scissor. */
+    const int wn = vf->w_n;
+    float box[4] = { (float)ge.scis_x1 - 1.0f, (float)ge.scis_y1 - 1.0f, (float)ge.scis_x2 + 2.0f, (float)ge.scis_y2 + 2.0f };
+    /* 5. the triangles, in the order draw_prim submits them; a flat PRIM's PSP colour vertex (its last) first, the winding kept
+     *    (one loop per primitive type, no drop test) */
+    uint32_t n = 0;
+    {
+        const int flat = !ge.shade_gouraud;
+        const int cull_on = ge.cull_enable != 0, cull_ccw = (ge.cull & 1) == 0;
+        const uint32_t *ref = s_tnl_ref;
+        uint32_t *out = s_tnl_tri;
+#define TNL_EMIT(A, B, C, FLIP) do { uint32_t a_ = (A), b_ = (B); const uint32_t c_ = (C); \
+            if (FLIP) { const uint32_t t_ = a_; a_ = b_; b_ = t_; } \
+            if (flat) { out[n] = c_; out[n + 1] = a_; out[n + 2] = b_; } else { out[n] = a_; out[n + 1] = b_; out[n + 2] = c_; } \
+            n += 3u; } while (0)
+        if (type == 3) {
+            const int flip = cull_on && cull_ccw;
+            for (int i = 2; i < count; i += 3) TNL_EMIT(ref[i - 2], ref[i - 1], ref[i], flip);
+        } else if (type == 4) {
+            for (int i = 2; i < count; i++) TNL_EMIT(ref[i - 2], ref[i - 1], ref[i], cull_on && (cull_ccw ^ (i & 1)));
+        } else {
+            const int flip = cull_on && cull_ccw;
+            for (int i = 2; i < count; i++) TNL_EMIT(ref[0], ref[i - 1], ref[i], flip);
+        }
+#undef TNL_EMIT
+    }
+    if (n == 0) return 1;   /* every triangle dropped: the PSP draws nothing either */
+    /* raster_tri prepares the depth surface before every triangle it hands the backend. */
+    if (ge.ztest_enable && !ge_zbuf_prepare_current()) return 1;
+    const uint8_t *raw;
+    uint32_t raw_bytes, vstride;   /* the vertices' offsets by their stride, no array of them */
+    if (raw_mode) {
+        raw = vb;
+        raw_bytes = nv * stride;
+        vstride = stride;
+    } else {
+        raw = (const uint8_t *)s_tnl_refs;
+        raw_bytes = nv * (uint32_t)sizeof(GeTnlVtx);
+        vstride = (uint32_t)sizeof(GeTnlVtx);
+    }
+    GeTnlParams *const pp = tnl_params_current(vf, raw_mode, wn, stride);
+#ifdef SR_GE_NATIVE
+    /* the module's say over a 2D T&L PRIM (an orthographic projection, no skinning: a menu's panel or
+     * text, a HUD's flash), as over a through-mode sprite: its pixels' box from its vertices here; dropped, or moved down by dy rows
+     * (the record's screen offset, in a copy with its own id) */
+    const GeTnlParams *use_pp = pp;
+    uint32_t use_id = s_params_id;
+    if (sdk_sprite_draw && !wn && nv <= 4096u && pp->proj[3] == 0.0f && pp->proj[7] == 0.0f && pp->proj[11] == 0.0f && pp->proj[15] != 0.0f) {
+        float bx0 = 1e30f, by0 = 1e30f, bx1 = -1e30f, by1 = -1e30f;
+        const float *W = pp->world, *V = pp->view, *P = pp->proj;
+        for (uint32_t u = 0; u < nv; u++) {
+            float m[3];
+            if (raw_mode) {
+                const uint8_t *q = vb + u * stride + vf->pos_off;
+                if (vf->pos_fmt == 3) memcpy(m, q, 12);
+                else if (vf->pos_fmt == 2) { int16_t t[3]; memcpy(t, q, 6); for (int k = 0; k < 3; k++) m[k] = t[k] * (1.0f / 32768.0f); }
+                else { const int8_t *t = (const int8_t *)q; for (int k = 0; k < 3; k++) m[k] = t[k] * (1.0f / 128.0f); }
+            } else {
+                m[0] = s_tnl_refs[u].x; m[1] = s_tnl_refs[u].y; m[2] = s_tnl_refs[u].z;
+            }
+            float w3[3], v3[3];
+            for (int r = 0; r < 3; r++) w3[r] = W[r] * m[0] + W[3 + r] * m[1] + W[6 + r] * m[2] + W[9 + r];
+            for (int r = 0; r < 3; r++) v3[r] = V[r] * w3[0] + V[3 + r] * w3[1] + V[6 + r] * w3[2] + V[9 + r];
+            const float cx = P[0] * v3[0] + P[4] * v3[1] + P[8] * v3[2] + P[12];
+            const float cy = P[1] * v3[0] + P[5] * v3[1] + P[9] * v3[2] + P[13];
+            const float sx = cx / P[15] * pp->vp[0] + pp->vp[3] - pp->off[0];
+            const float sy = cy / P[15] * pp->vp[1] + pp->vp[4] - pp->off[1];
+            bx0 = fminf(bx0, sx); bx1 = fmaxf(bx1, sx); by0 = fminf(by0, sy); by1 = fmaxf(by1, sy);
+        }
+        if (bx0 <= bx1 && by0 <= by1) {
+            SdkSpriteDraw d = { ge.tex_addr, ge.tex_enable, 0, bx0, by0, bx1, by1, 0.0f, 0, -1e9f, -1e9f, -1e9f, -1e9f, ge.tex_w, ge.tex_h, 0 };
+            d.tnl = 1;
+            sdk_sprite_draw(&d);
+            if (d.skip) return 1;
+            if (d.dy != 0.0f) {
+                static GeTnlParams s_moved;
+                static uint32_t s_moved_base, s_moved_id;
+                static float s_moved_dy;
+                if (!s_moved_id || s_moved_base != s_params_id || s_moved_dy != d.dy) {
+                    s_moved = *pp;
+                    s_moved.off[1] -= d.dy;
+                    s_moved_base = s_params_id;
+                    s_moved_dy = d.dy;
+                    s_moved_id = tnl_next_params_id();
+                }
+                use_pp = &s_moved;
+                use_id = s_moved_id;
+            }
+        }
+    }
+#else
+    const GeTnlParams *use_pp = pp;
+    const uint32_t use_id = s_params_id;
+#endif
+    /* the backend's limit is 65536 indices a PRIM: a larger one goes in pieces, every piece with the whole vertex range */
+    const uint32_t per = 21840u * 3u;
+    for (uint32_t t0 = 0; t0 < n; t0 += per) {
+        const uint32_t tn = n - t0 < per ? n - t0 : per;
+        GeTnlPrim prim = { use_pp, s_tnl_refs, nv, s_tnl_tri + t0, tn / 3u,
+                           { box[0], box[1], box[2], box[3] }, raw, raw_bytes, NULL, use_id, vstride };
+        uint64_t profile_started = ge_cpu_profile_begin();
+        const int taken = s_gpu->tnl_prim(&prim);
+        ge_cpu_profile_end(GE_CPU_GPU_HOOK, profile_started);
+        if (!taken) {
+            static int said;
+            if (!said++)
+                fprintf(stderr, "ge: GPU T&L: the backend refused a PRIM (%u vertices, %u bytes, %u triangles): not drawn, said once\n",
+                        nv, raw_bytes, tn / 3u);
+            return 1;
+        }
+    }
+    s_tnl_taken++;
+    s_stat.gpuprim += n / 3u;
+    return 1;
+}
+
+/* a BEZIER or SPLINE of triangles through the GPU's T&L: the patches' grid points evaluated once each
+ * (draw_patch evaluated every quad's four corners and sent each triangle down the CPU path) into GeTnlVtx records, the triangles
+ * draw_patch makes (q0 q2 q1, q1 q2 q3 a quad, the cull flip and flat shading's first vertex as draw_prim's), one PRIM (pieces past
+ * the backend's limit). 0: not taken (lines, points, through mode, skinning, morphing, state T&L can't draw): draw_patch's own path */
+static int ge_tnl_try_patch(const VFmt *vf, const ModelVtx *all, int nu, int pu, int pv, int tu, int tv, int spline, int typeu,
+                            int typev) {
+    if (!s_gpu || !s_gpu->tnl_prim || !tnl_enabled() || s_wide_d) return 0;
+    if (vf->through || vf->w_n || vf->morph_n > 1 || !tnl_state_ok(3, vf)) return 0;
+    const uint32_t gw = (uint32_t)tu + 1u, gh = (uint32_t)tv + 1u, per_patch = gw * gh;
+    const uint32_t nvtx = per_patch * (uint32_t)pu * (uint32_t)pv, ntri = 2u * (uint32_t)tu * (uint32_t)tv * (uint32_t)pu * (uint32_t)pv;
+    if (!nvtx || !ntri) return 0;
+    if (!tnl_grow((void **)&s_tnl_refs, &s_tnl_refs_cap, nvtx, sizeof(GeTnlVtx)) ||
+        !tnl_grow((void **)&s_tnl_tri, &s_tnl_tri_cap, ntri * 3u, sizeof(uint32_t)))
+        return 0;
+    const int gen = vf->tc_off < 0;
+    PatchWeight wu[129], wv[129];
+    uint32_t nv = 0, n = 0;
+    const int flat = !ge.shade_gouraud, flip = ge.cull_enable && (ge.cull & 1) == 0;
+    for (int py = 0; py < pv; py++) {
+        for (int y = 0; y <= tv; y++) {
+            if (spline) spline_weight(py, y, tv, pv, typev, &wv[y]);
+            else bezier_weight((float)y / (float)tv, &wv[y]);
+        }
