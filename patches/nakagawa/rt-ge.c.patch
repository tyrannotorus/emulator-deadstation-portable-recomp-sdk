+        abort();
+    }
+    uint64_t w = (s_rg_w[g] + align - 1u) & ~(uint64_t)(align - 1u);
+    if (w % size + n > size) w = (w / size + 1u) * size;
+    for (int tries = 0; w + n > gegpu_ring_free(g) + size; tries++) {
+        if (tries == 2) {
+            fprintf(stderr, "ge: the T&L ring stays full with the GPU idle: stopping\n");
+            abort();
+        }
+        split_room();
+    }
+    s_rg_w[g] = w + n;
+    return w;
+}
+
+/* a PRIM into the ring: what the GPU reads, written here; the back gets the draw */
+static int split_tnl_ring(const GeTnlPrim *p) {
+    split_state();
+    const uint32_t nv = p->ntri * 3u, nr = p->nrefs;
+    const uint64_t half = s_rg_size[1] / 2u;
+    /* the record: again when it differs, or before the ring comes round to it */
+    if (!s_rg_par_valid || p->params_id == 0u || p->params_id != s_rg_par_id || s_rg_w[1] - s_rg_par_pos > half) {
+        const uint64_t pos = rg_alloc(1, (uint32_t)sizeof(GeTnlParams), s_rg_align);
+        memcpy(rg_ptr(1, pos), p->params, sizeof(GeTnlParams));
+        s_rg_par_pos = pos;
+        s_rg_par_id = p->params_id;
+        s_rg_par_valid = 1;
+    }
+    uint64_t lo1 = s_rg_par_pos;
+    /* the raw vertices: within one run, a range an earlier PRIM's copy holds is read there */
+    const int ours = p->raw == (const uint8_t *)s_tnl_refs;
+    uint64_t rawpos = UINT64_MAX;
+    if (!ours)
+        for (int k = 0; k < 4; k++) {
+            const uint8_t *r = s_rg_recent[k].raw;
+            if (r && s_rg_recent[k].run == g_ge_run_gen && p->raw >= r && p->raw + p->raw_bytes <= r + s_rg_recent[k].bytes &&
+                s_rg_w[1] - s_rg_recent[k].pos < half) {
+                rawpos = s_rg_recent[k].pos + (uint64_t)(p->raw - r);
+                break;
+            }
+        }
+    if (rawpos == UINT64_MAX) {
+        rawpos = rg_alloc(1, p->raw_bytes, 4u);
+        memcpy(rg_ptr(1, rawpos), p->raw, p->raw_bytes);
+        if (!ours) {
+            s_rg_recent[s_rg_next].raw = p->raw;
+            s_rg_recent[s_rg_next].bytes = p->raw_bytes;
+            s_rg_recent[s_rg_next].run = g_ge_run_gen;
+            s_rg_recent[s_rg_next].pos = rawpos;
+            s_rg_next = (s_rg_next + 1) & 3;
+        }
+    }
+    if (rawpos < lo1) lo1 = rawpos;
+    /* the corners (psp_tnl.vert's vertex input: the vertex's byte offset in the ring, a record index it no longer reads) */
+    const uint64_t cpos = rg_alloc(1, nr * 8u, 8u);
+    if (cpos < lo1) lo1 = cpos;
+    {
+        uint32_t *c = rg_ptr(1, cpos);
+        const uint32_t roff = s_rg_base[1] + (uint32_t)(rawpos % s_rg_size[1]);
+        if (p->vtx_off)
+            for (uint32_t u = 0; u < nr; u++) { c[2u * u] = roff + p->vtx_off[u]; c[2u * u + 1u] = 0u; }
+        else {
+            const uint32_t st = p->vtx_stride;
+            for (uint32_t u = 0; u < nr; u++) { c[2u * u] = roff + u * st; c[2u * u + 1u] = 0u; }
+        }
+    }
+    /* the indices: into the corners, contiguous with the PRIM before */
+    const uint64_t ipos = rg_alloc(0, nv * 4u, 4u);
+    {
+        uint32_t *ix = rg_ptr(0, ipos);
+        const uint32_t cb = rg_off(1, cpos) / 8u;
+        const uint32_t *t = p->tri;
+        for (uint32_t k = 0; k < nv; k++) ix[k] = cb + t[k];
+    }
+    SplitTnlR *r = split_reserve(K_TNLR, sizeof *r);
+    memcpy(r->box, p->box, sizeof r->box);
+    r->ntri = p->ntri;
+    r->nrefs = nr;
+    r->first = rg_off(0, ipos) / 4u;
+    r->param = rg_off(1, s_rg_par_pos);
+    r->lo[0] = ipos;
+    r->lo[1] = lo1;
+    r->end[0] = s_rg_w[0];
+    r->end[1] = s_rg_w[1];
+    split_commit();
+    return 1;
+}
+
+static int split_tnl(const GeTnlPrim *p) {
+    if (s_rg_on < 0) {
+        uint32_t ib = 0, db = 0;
+        s_rg_on = gegpu_ring_get && gegpu_ring_free && gegpu_ring_room && gegpu_ring_get(&s_rg_map, &ib, &db, &s_rg_align);
+        s_rg_size[0] = ib;
+        s_rg_size[1] = db;
+        s_rg_base[0] = 0u;
+        s_rg_base[1] = ib;
+    }
+    if (s_rg_on) return split_tnl_ring(p);
+    split_state();
+    /* the record: sent when it differs from the one the back has; a PRIM then carries that one's id, so the renderer reuses what it
+     * staged without comparing */
+    if (!s_sent_params_any || p->params_id == 0u || p->params_id != s_seen_params_id) {
+        /* only its 64-byte blocks that moved cross to the other core (an object's PRIMs: the world matrix, the bones) */
+        const uint8_t *np = (const uint8_t *)p->params;
+        uint8_t *sp = (uint8_t *)&s_sent_params;
+        uint32_t mask = 0, bytes = 0;
+        for (uint32_t i = 0; i < PARAM_BLOCKS; i++) {
+            const uint32_t o = i * 64u, n = (uint32_t)sizeof(GeTnlParams) - o < 64u ? (uint32_t)sizeof(GeTnlParams) - o : 64u;
+            if (!s_sent_params_any || memcmp(np + o, sp + o, n) != 0) { mask |= 1u << i; bytes += n; }
+        }
+        if (mask) {
+            uint32_t *r = split_reserve(K_PARAMS, (uint32_t)sizeof(uint32_t) + bytes);
+            r[0] = mask;
+            uint8_t *d = (uint8_t *)(r + 1);
+            for (uint32_t i = 0; i < PARAM_BLOCKS; i++)
+                if (mask & (1u << i)) {
+                    const uint32_t o = i * 64u, n = (uint32_t)sizeof(GeTnlParams) - o < 64u ? (uint32_t)sizeof(GeTnlParams) - o : 64u;
+                    memcpy(d, np + o, n);
+                    memcpy(sp + o, np + o, n);
+                    d += n;
+                }
+            s_sent_params_id = p->params_id;
+            s_sent_params_any = 1;
+        }
+        s_seen_params_id = p->params_id;
+    }
+    /* guest memory a PRIM's raw vertices point at stays as it is until the run is over; the front's own buffers don't */
+    const int raw_ours = p->raw && p->raw == (const uint8_t *)s_tnl_refs;
+    /* indices under 65536 (every PRIM's but a huge one's) go as 16 bits: half the bytes to the other core */
+    const int idx16 = p->nrefs <= 65536u && p->ntri * 3u <= 65536u;
+    const uint32_t idx = p->ntri * 3u * (idx16 ? 2u : 4u);
+    const uint32_t raw = raw_ours ? p->raw_bytes : 0u;
+    const uint32_t off = p->vtx_off ? p->nrefs * (uint32_t)sizeof(uint32_t) : 0u;
+    const uint32_t refs = !p->raw ? p->nrefs * (uint32_t)sizeof(GeTnlVtx) : 0u;
+    const uint32_t pad = (idx + raw + off) & 7u ? 8u - ((idx + raw + off) & 7u) : 0u;
+    SplitTnl *r = split_reserve(K_TNL, (uint32_t)sizeof *r + idx + raw + off + pad + refs);
+    r->prim = *p;
+    r->prim.params_id = s_sent_params_id;
+    r->prim.tri16 = NULL;
+    r->idx_bytes = idx;
+    r->raw_bytes = raw;
+    r->off_bytes = off;
+    r->refs_bytes = refs;
+    r->idx16 = (uint32_t)idx16;
+    uint8_t *d = (uint8_t *)(r + 1);
+    if (idx16) {
+        uint16_t *o = (uint16_t *)d;
+        const uint32_t *t = p->tri, n = p->ntri * 3u;
+        for (uint32_t k = 0; k < n; k++) o[k] = (uint16_t)t[k];
+    } else
+        memcpy(d, p->tri, idx);
+    if (raw) memcpy(d + idx, p->raw, raw);
+    if (off) memcpy(d + idx + raw, p->vtx_off, off);
+    if (refs) memcpy(d + idx + raw + off + pad, p->refs, refs);
+    split_commit();
+    return 1;
+}
+
+static void split_flush(const char *reason) {
+    split_state();
+    ((SplitFlush *)split_reserve(K_FLUSH, sizeof(SplitFlush)))->reason = reason;
+    split_commit();
+}
+static void split_vram_dirty(uint32_t addr, uint32_t bytes) {
+    SplitWord2 *r = split_reserve(K_DIRTY, sizeof *r);
+    r->a = addr;
+    r->b = bytes;
+    split_publish();
+}
+/* the operations the front needs an answer from: run by the back, waited for */
+static int split_call_wait(void) {
+    split_publish();
+    split_wait_head(s_wtail);
+    return s_call_result;
+}
+static int split_xfer(uint32_t startdata) {
+    split_state();
+    ((SplitWord2 *)split_reserve(K_XFER, sizeof(SplitWord2)))->a = startdata;
+    return split_call_wait();
+}
+static int split_capture_boundary(void) {
+    split_state();
+    split_reserve(K_CAPTURE, 0);
+    return split_call_wait();
+}
+static int split_wing(uint32_t kind, uint32_t fb, int x0, int x1, const GeVtx *a, const GeVtx *b, const GeVtx *c, int persp) {
+    split_state();
+    SplitWing *r = split_reserve(kind, sizeof *r);
+    r->fb = fb; r->x0 = x0; r->x1 = x1;
+    r->v[0] = *a; r->v[1] = *b;
+    if (c) r->v[2] = *c;
+    r->persp = persp;
+    return split_call_wait();
+}
+static int split_wing_tri(uint32_t fb, int x0, int x1, const GeVtx *a, const GeVtx *b, const GeVtx *c, int persp) {
+    return split_wing(K_WING_TRI, fb, x0, x1, a, b, c, persp);
+}
+static int split_wing_sprite(uint32_t fb, int x0, int x1, const GeVtx *a, const GeVtx *b, int persp) {
+    return split_wing(K_WING_SPRITE, fb, x0, x1, a, b, NULL, persp);
+}
+
+/* (ge_worker.c) `fn` with a copy of `arg` on the back, after everything posted before; frame_end: a present (dev timing) */
+void ge_split_post(void (*fn)(const void *), const void *arg, uint32_t bytes, int frame_end) {
+    SplitPost *r = split_reserve(K_POST, (uint32_t)sizeof *r + bytes);
+    r->fn = fn;
+    r->frame_end = (uint32_t)frame_end;
+    memcpy(r + 1, arg, bytes);
+    split_publish();
+}
+int ge_split_on(void) { return s_split_on; }
+/* everything posted run (any thread; the front quiet) */
+void ge_split_drain(void) {
+    if (s_split_on) split_wait_head(atomic_load(&s_rtail));
+}
+/* (dev) the back's busy time and its longest frame of work since the last call, in ns */
+void ge_split_dev(uint64_t *busy, uint64_t *longest) {
+    *busy = s_back_busy;
+    *longest = s_back_longest;
+    s_back_busy = s_back_longest = 0;
+}
+
+static void split_declined(const char *what) {
+    static int said;
+    if (!said++) fprintf(stderr, "ge: the renderer left out %s: not drawn, said once\n", what);
+}
+
+static void split_run(const SplitHdr *h) {
+    const void *q = h + 1;
+    switch (h->kind) {
+    case K_WRAP: break;
+    case K_STATE: {
+        const uint8_t *p = q;
+        memcpy(&s_back_x, p, sizeof(SplitX));
+        p += sizeof(SplitX);
+        uint32_t mask;
+        memcpy(&mask, p, sizeof mask);
+        p += sizeof mask;
+        uint8_t *g = (uint8_t *)&s_back_state;
+        for (int i = 0; i < SPLIT_BLOCKS; i++)
+            if (mask & (1u << i)) {
+                memcpy(g + s_blk_off[i], p, s_blk_len[i]);
+                p += s_blk_len[i];
+            }
+        break;
+    }
+    case K_CLUT: { const uint32_t *c = q; memcpy(s_back_state.clutram, c + 1, c[0]); break; }
+    case K_PARAMS: {
+        const uint32_t *r = q, mask = r[0];
+        const uint8_t *d = (const uint8_t *)(r + 1);
+        uint8_t *bp = (uint8_t *)&s_back_params;
+        for (uint32_t i = 0; i < PARAM_BLOCKS; i++)
+            if (mask & (1u << i)) {
+                const uint32_t o = i * 64u, n = (uint32_t)sizeof(GeTnlParams) - o < 64u ? (uint32_t)sizeof(GeTnlParams) - o : 64u;
+                memcpy(bp + o, d, n);
+                d += n;
+            }
+        break;
+    }
+    case K_TRI: { const SplitPrim *r = q; if (!s_real->tri(&r->v[0], &r->v[1], &r->v[2], r->persp)) split_declined("a triangle"); break; }
+    case K_SPRITE: { const SplitPrim *r = q; if (!s_real->sprite(&r->v[0], &r->v[1], r->persp)) split_declined("a sprite"); break; }
+    case K_LINE: { const SplitPrim *r = q; if (!s_real->line(&r->v[0], &r->v[1], r->persp)) split_declined("a line"); break; }
+    case K_POINT: { const SplitPrim *r = q; if (!s_real->point(&r->v[0], r->persp)) split_declined("a point"); break; }
+    case K_TNL: {
+        const SplitTnl *r = q;
+        const uint8_t *d = (const uint8_t *)(r + 1);
+        GeTnlPrim p = r->prim;
+        p.params = &s_back_params;
+        if (r->idx16) {
+            p.tri16 = (const uint16_t *)d;
+            p.tri = NULL;
+        } else
+            p.tri = (const uint32_t *)d;
+        if (r->raw_bytes) p.raw = d + r->idx_bytes;
+        if (r->off_bytes) p.vtx_off = (const uint32_t *)(d + r->idx_bytes + r->raw_bytes);
+        if (r->refs_bytes) {
+            const uint32_t at = r->idx_bytes + r->raw_bytes + r->off_bytes;
+            p.refs = (const GeTnlVtx *)(d + at + (at & 7u ? 8u - (at & 7u) : 0u));
+        }
+        if (!s_real->tnl_prim(&p)) split_declined("a T&L PRIM");
+        break;
+    }
+    case K_FLUSH: s_real->flush(((const SplitFlush *)q)->reason); break;
+    case K_DIRTY: { const SplitWord2 *r = q; s_real->vram_dirty(r->a, r->b); break; }
+    case K_XFER: s_call_result = s_real->xfer(((const SplitWord2 *)q)->a); break;
+    case K_CAPTURE: s_call_result = s_real->capture_boundary ? s_real->capture_boundary() : 1; break;
+    case K_WING_TRI: { const SplitWing *r = q; s_call_result = s_real->wing_tri(r->fb, r->x0, r->x1, &r->v[0], &r->v[1], &r->v[2], r->persp); break; }
+    case K_WING_SPRITE: { const SplitWing *r = q; s_call_result = s_real->wing_sprite(r->fb, r->x0, r->x1, &r->v[0], &r->v[1], r->persp); break; }
+    case K_POST: { const SplitPost *r = q; r->fn(r + 1); break; }
+    case K_TNLR: {
+        const SplitTnlR *r = q;
+        GeTnlPrim p;
+        memset(&p, 0, sizeof p);
+        memcpy(p.box, r->box, sizeof p.box);
+        p.ntri = r->ntri;
+        p.nrefs = r->nrefs;
+        p.ring = 1;
+        p.ring_first = r->first;
+        p.ring_param = r->param;
+        memcpy(p.ring_lo, r->lo, sizeof p.ring_lo);
+        memcpy(p.ring_end, r->end, sizeof p.ring_end);
+        if (!s_real->tnl_prim(&p)) split_declined("a T&L PRIM");
+        break;
+    }
+    case K_ROOM: gegpu_ring_room(); s_call_result = 1; break;
+    default:
+        fprintf(stderr, "ge: the renderer's ring holds an operation %u: stopping\n", h->kind);
+        abort();
+    }
+}
+
+static uint64_t split_now(void) {
+    struct timespec t;
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    return (uint64_t)t.tv_sec * 1000000000ull + (uint64_t)t.tv_nsec;
+}
+
+void brick_affinity(int core) __attribute__((weak));
+static void *split_back(void *arg) {
+    (void)arg;
+    t_ge = &s_back_state;
+    if (brick_affinity) brick_affinity(3);   /* the renderer on core 3 (runtime/brick/affinity.c) */
+    uint32_t head = atomic_load(&s_rhead);
+    for (;;) {
+        uint32_t tail = atomic_load_explicit(&s_rtail, memory_order_acquire);
+        for (int i = 0; head == tail && i < 4000; i++) {
+            __asm__ volatile("yield");
+            tail = atomic_load_explicit(&s_rtail, memory_order_acquire);
+        }
+        if (head == tail) {
+            pthread_mutex_lock(&s_split_m);
+            atomic_store(&s_back_sleeps, 1);
+            while (head == (tail = atomic_load(&s_rtail)) && !s_split_quit) pthread_cond_wait(&s_split_work, &s_split_m);
+            atomic_store(&s_back_sleeps, 0);
+            const int quit = s_split_quit && head == tail;
+            pthread_mutex_unlock(&s_split_m);
+            if (quit) break;
+            continue;
+        }
+        uint64_t t0 = s_split_timing ? split_now() : 0;
+        uint32_t pub = head;
+        while (head != tail) {
+            const SplitHdr *h = (const SplitHdr *)(s_ring + head % SPLIT_RING);
+            /* the front wrote these lines on its own core: asked for ahead of their use */
+            __builtin_prefetch(s_ring + (head + 256u) % SPLIT_RING);
+            __builtin_prefetch(s_ring + (head + 320u) % SPLIT_RING);
+            split_run(h);
+            if (s_split_timing && h->kind == K_POST && ((const SplitPost *)(h + 1))->frame_end) {
+                const uint64_t t = split_now();
+                s_back_busy += t - t0;
+                s_back_frame += t - t0;
+                t0 = t;
+                if (s_back_frame > s_back_longest) s_back_longest = s_back_frame;
+                s_back_frame = 0;
+            }
+            head += h->bytes;
+            if (head == tail) tail = atomic_load_explicit(&s_rtail, memory_order_acquire);
+            if (head == tail || head - pub >= SPLIT_PUBLISH) {
+                pub = head;
+                atomic_store(&s_rhead, head);
+                if (atomic_load(&s_waiters)) {
+                    pthread_mutex_lock(&s_split_m);
+                    pthread_cond_broadcast(&s_split_progress);
+                    pthread_mutex_unlock(&s_split_m);
+                }
+            }
+        }
+        if (s_split_timing) {
+            const uint64_t t = split_now();
+            s_back_busy += t - t0;
+            s_back_frame += t - t0;
+        }
+    }
+    return NULL;
+}
+
+/* at exit (the front quiet): everything run, the back gone */
+void ge_split_stop(void) {
+    if (!s_split_on) return;
+    ge_split_drain();
+    pthread_mutex_lock(&s_split_m);
+    s_split_quit = 1;
+    pthread_cond_signal(&s_split_work);
+    pthread_mutex_unlock(&s_split_m);
+    pthread_join(s_back_thread, NULL);
+    s_split_on = 0;
+    s_gpu = s_real;
+}
+
+static const GeGpuHooks *split_wrap(const GeGpuHooks *h) {
+    if (!h || s_split_on || !split_wanted()) return h;
+    s_ring = aligned_alloc(64, SPLIT_RING);
+    if (!s_ring) {
+        fprintf(stderr, "ge: no memory for the renderer's ring: stopping\n");
+        abort();
+    }
+    const char *tm = getenv("DSP_HLETIME");
+    s_split_timing = tm && tm[0] == '1';
+    split_blocks_init();
+    s_real = h;
+    s_back_state = ge_live;
+    s_proxy = *h;
+    s_proxy.tri = split_tri;
+    s_proxy.sprite = split_sprite;
+    s_proxy.line = split_line;
+    s_proxy.point = split_point;
+    s_proxy.flush = split_flush;
+    s_proxy.vram_dirty = split_vram_dirty;
+    s_proxy.xfer = h->xfer ? split_xfer : NULL;
+    s_proxy.capture_boundary = h->capture_boundary ? split_capture_boundary : NULL;
+    /* vram_read, vram_write_prepare and vram_pending stay the renderer's own: constants in the native build ,
+     * asked from the game's thread */
+    s_proxy.tnl_prim = h->tnl_prim ? split_tnl : NULL;
+    s_proxy.wing_tri = h->wing_tri ? split_wing_tri : NULL;
+    s_proxy.wing_sprite = h->wing_sprite ? split_wing_sprite : NULL;
+    if (pthread_create(&s_back_thread, NULL, split_back, NULL) != 0) {
+        fprintf(stderr, "ge: the renderer's thread did not start: stopping\n");
+        abort();
+    }
+    s_split_on = 1;
+    fprintf(stderr, "ge: two stages: the display list on the GE's thread, the renderer on its own\n");
+    return &s_proxy;
+}
+#endif
