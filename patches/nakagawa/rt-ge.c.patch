+static void *split_reserve(uint32_t kind, uint32_t bytes) {
+    if (!ge_worker_is_self()) {
+        fprintf(stderr, "ge: a renderer call (%u) from a thread not the GE's: stopping\n", kind);
+        abort();
+    }
+    const uint32_t need = (uint32_t)((sizeof(SplitHdr) + bytes + 15u) & ~15u);
+    if (need > SPLIT_RING / 4u) {
+        fprintf(stderr, "ge: a renderer operation of %u bytes: more than the ring takes, stopping\n", need);
+        abort();
+    }
+    uint32_t off = s_wtail % SPLIT_RING;
+    const uint32_t pad = off + need > SPLIT_RING ? SPLIT_RING - off : 0u;
+    if (s_wtail + pad + need - s_whead > SPLIT_RING) {
+        split_publish();
+        split_wait_head(s_wtail + pad + need - SPLIT_RING);
+        s_whead = atomic_load_explicit(&s_rhead, memory_order_acquire);
+    }
+    if (pad) {
+        SplitHdr *w = (SplitHdr *)(s_ring + off);
+        w->kind = K_WRAP;
+        w->bytes = pad;
+        s_wtail += pad;
+        off = 0;
+    }
+    SplitHdr *h = (SplitHdr *)(s_ring + off);
+    h->kind = kind;
+    h->bytes = need;
+    s_wtail += need;
+    return h + 1;
+}
