+static int s_direct_state;   /* 0 not built, 1 built, -1 not usable */
+static void direct_build(void) {
+    s_direct_state = -1;
+    const uint32_t lo = 0x08800000u, hi = sr_loaded_end();
+    if (hi <= lo || hi - lo > 0x01800000u) {
+        fprintf(stderr, "dispatch: no direct table (image 0x%08x..0x%08x)\n", lo, hi);
+        return;
+    }
+    const uint32_t n = (hi - lo) / 4u + 1u;
+    uint32_t *t = (uint32_t *)calloc(n, sizeof(uint32_t));
+    if (!t) { fprintf(stderr, "dispatch: no direct table (out of memory)\n"); return; }
+    uint32_t filled = 0;
+    for (uint32_t h = 0; h <= SR_DTAB_MASK; h++) {
+        if (atomic_load_explicit(&g_dtab.main[h].state, memory_order_acquire) == 0u) continue;
+        const uint32_t a = atomic_load_explicit(&g_dtab.main[h].addr, memory_order_relaxed);
+        const uintptr_t fn = atomic_load_explicit(&g_dtab.main[h].fn, memory_order_relaxed);
+        if (a < lo || a > hi || (a & 3u)) continue;
+        if (fn > 0xFFFFFFFFu) {
+            fprintf(stderr, "dispatch: no direct table (a body above 4 GiB: %p)\n", (void *)fn);
+            free(t);
+            return;
+        }
+        t[(a - lo) / 4u] = (uint32_t)fn;
+        filled++;
+    }
+    s_direct = t;
+    s_direct_lo = lo;
+    s_direct_n = n;
+    s_direct_state = 1;
+    fprintf(stderr, "dispatch: direct table, %u bodies over 0x%08x..0x%08x\n", filled, lo, hi);
+}
+static inline RecompFn direct_fn(uint32_t addr) {
+    const uint32_t i = (addr - s_direct_lo) >> 2;
+    if (__builtin_expect(i < s_direct_n && (addr & 3u) == 0u, 1)) {
+        const uint32_t v = s_direct[i];
+        if (v) return (RecompFn)(uintptr_t)v;
+    }
+    return NULL;
+}
+#endif
