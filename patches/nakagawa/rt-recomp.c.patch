+#ifdef SR_FASTMEM
+/* Fastmem's fault handler (recomp.h SR_FASTMEM). A load or store the guest's view refuses is decoded
+ * here (AArch64: single register, pair, SIMD and FP; offset, register, pre- and post-index forms), run through the full accessors
+ * (sr_*_ref) at the guest address it reached, its result put in its register and its base written back, and the thread goes on
+ * after it. Any other fault, or an instruction this does not decode, goes to the handler that was there before (the default:
+ * the process ends), said on stderr first. */
+#include <signal.h>
+#include <ucontext.h>
+#include <unistd.h>
+
+static struct sigaction s_fm_prev_segv, s_fm_prev_bus;
+static atomic_ulong s_fm_faults, s_fm_pages;
+/* A CPU store to VRAM: the page (of the mirror it came through) opened at its first store and closed again at the GE worker's next
+ * post (sr_fastmem_vram_flush), which then reports it dirty: a page a fault, not a store a fault (the game clears all 2 MiB at
+ * boot). 8 mirrors x 512 pages. */
+static _Atomic uint64_t s_fm_vram_open[64];
+
+struct fm_ctx_head { uint32_t magic, size; };
+struct fm_fpsimd { struct fm_ctx_head head; uint32_t fpsr, fpcr; __uint128_t vregs[32]; };
+
+static __uint128_t *fm_vregs(ucontext_t *uc) {
+    uint8_t *p = (uint8_t *)uc->uc_mcontext.__reserved;
+    for (size_t off = 0; off + sizeof(struct fm_ctx_head) <= sizeof(uc->uc_mcontext.__reserved);) {
+        const struct fm_ctx_head *h = (const struct fm_ctx_head *)(p + off);
+        if (h->magic == 0u || h->size == 0u) break;
+        if (h->magic == 0x46508001u) return ((struct fm_fpsimd *)(p + off))->vregs;   /* FPSIMD_MAGIC */
+        off += h->size;
+    }
+    return NULL;
+}
+
+static void fm_load(uint32_t ga, unsigned bytes, uint8_t *out) {
+    for (unsigned i = 0; i < bytes;) {
+        if (bytes - i >= 4u) { const uint32_t v = sr_r32_ref(ga + i); memcpy(out + i, &v, 4); i += 4u; }
+        else if (bytes - i >= 2u) { const uint16_t v = sr_r16_ref(ga + i); memcpy(out + i, &v, 2); i += 2u; }
+        else { out[i] = sr_r8_ref(ga + i); i += 1u; }
+    }
+}
+static void fm_store(uint32_t ga, unsigned bytes, const uint8_t *in) {
+    for (unsigned i = 0; i < bytes;) {
+        if (bytes - i >= 4u) { uint32_t v; memcpy(&v, in + i, 4); sr_w32_pc_ref(ga + i, v, 0u); i += 4u; }
+        else if (bytes - i >= 2u) { uint16_t v; memcpy(&v, in + i, 2); sr_w16_pc_ref(ga + i, v, 0u); i += 2u; }
+        else { sr_w8_pc_ref(ga + i, in[i], 0u); i += 1u; }
+    }
+}
+
+/* 1: run (pc moved past it), 0: not an access this decodes, or not into the guest's view */
+static int fm_emulate(ucontext_t *uc, uint32_t insn, uint32_t *ga_out) {
+    uint64_t *x = (uint64_t *)uc->uc_mcontext.regs;
+    const unsigned rt = insn & 31u, rn = (insn >> 5) & 31u;
+    const uint64_t base = rn == 31u ? (uint64_t)uc->uc_mcontext.sp : x[rn];
+    const int vec = (int)((insn >> 26) & 1u);
+    unsigned bytes, n = 1u, rt2 = 0u;
+    int load, sext = 0, w32 = 0, wb = 0, post = 0;
+    int64_t off;
+    if ((insn & 0x3A000000u) == 0x28000000u) {   /* LDP, STP, LDNP, STNP, LDPSW */
+        const unsigned opc = insn >> 30, mode = (insn >> 23) & 3u;
+        load = (int)((insn >> 22) & 1u);
+        if (vec) { if (opc == 3u) return 0; bytes = 4u << opc; }
+        else { if (opc == 3u || (opc == 1u && !load)) return 0; bytes = (opc & 2u) ? 8u : 4u; sext = opc == 1u; }
+        n = 2u;
+        rt2 = (insn >> 10) & 31u;
+        off = (int64_t)((int32_t)(insn << 10) >> 25) * (int64_t)bytes;
+        if (mode == 1u) { post = 1; wb = 1; } else if (mode == 3u) wb = 1;
+    } else {
+        const unsigned size = insn >> 30, opc = (insn >> 22) & 3u;
+        unsigned scale;
+        if (vec) {
+            if (opc & 2u) { if (size) return 0; bytes = 16u; scale = 4u; } else { bytes = 1u << size; scale = size; }
+            load = (int)(opc & 1u);
+        } else {
+            bytes = 1u << size; scale = size;
+            if (opc == 0u) load = 0;
+            else if (opc == 1u) load = 1;
+            else if (opc == 2u) { if (size == 3u) return 0; load = 1; sext = 1; }   /* LDRS* to X (PRFM never faults) */
+            else { if (size >= 2u) return 0; load = 1; sext = 1; w32 = 1; }         /* LDRSB, LDRSH to W */
+        }
+        if ((insn & 0x3B000000u) == 0x39000000u) {   /* unsigned offset */
+            off = (int64_t)((uint64_t)((insn >> 10) & 0xFFFu) << scale);
+        } else if ((insn & 0x3B200000u) == 0x38000000u) {   /* unscaled, post-index, unprivileged, pre-index */
+            const unsigned m = (insn >> 10) & 3u;
+            off = (int64_t)((int32_t)(insn << 11) >> 23);
+            if (m == 1u) { post = 1; wb = 1; } else if (m == 3u) wb = 1;
+        } else if ((insn & 0x3B200C00u) == 0x38200800u) {   /* register offset */
+            const unsigned rm = (insn >> 16) & 31u, option = (insn >> 13) & 7u, sh = (insn >> 12) & 1u;
+            uint64_t mv = rm == 31u ? 0u : x[rm];
+            if (option == 2u) mv = (uint32_t)mv;
+            else if (option == 6u) mv = (uint64_t)(int64_t)(int32_t)mv;
+            else if (option != 3u && option != 7u) return 0;
+            off = (int64_t)(mv << (sh ? scale : 0u));
+        } else {
+            return 0;
+        }
+    }
+    const uint64_t ea = post ? base : base + (uint64_t)off;
+    if (ea < SR_MEM_FIXED_ARENA || ea - SR_MEM_FIXED_ARENA >= 0x100000000ull) return 0;
+    __uint128_t *vr = vec ? fm_vregs(uc) : NULL;
+    if (vec && !vr) return 0;
+    const uint32_t ga = (uint32_t)(ea - SR_MEM_FIXED_ARENA);
+    for (unsigned i = 0; i < n; i++) {
+        const unsigned r = i ? rt2 : rt;
+        const uint32_t a = ga + i * bytes;
+        uint8_t buf[16] = { 0 };
+        if (load) {
+            fm_load(a, bytes, buf);
+            if (vec) {
+                __uint128_t v = 0;
+                memcpy(&v, buf, bytes);
+                vr[r] = v;
+            } else if (r != 31u) {
+                uint64_t v = 0;
+                memcpy(&v, buf, bytes);
+                if (sext) {
+                    const unsigned shift = 64u - 8u * bytes;
+                    v = (uint64_t)((int64_t)(v << shift) >> shift);
+                    if (w32) v = (uint32_t)v;
+                }
+                x[r] = v;
+            }
+        } else {
+            if (vec) memcpy(buf, &vr[r], bytes);
+            else { const uint64_t v = r == 31u ? 0u : x[r]; memcpy(buf, &v, bytes); }
+            fm_store(a, bytes, buf);
+        }
+    }
+    if (wb) {
+        const uint64_t nb = base + (uint64_t)off;
+        if (rn == 31u) uc->uc_mcontext.sp = nb; else x[rn] = nb;
+    }
+    uc->uc_mcontext.pc += 4u;
+    *ga_out = ga;
+    return 1;
+}
+
+static void fm_say(const char *what, unsigned long count, uint32_t insn, uint64_t pc, uint32_t ga) {
+    char line[200];
+    const int n = snprintf(line, sizeof(line), "fastmem: %s %lu (instruction 0x%08x at pc 0x%llx, guest address 0x%08x)\n", what,
+                           count, insn, (unsigned long long)pc, ga);
+    if (n > 0) { ssize_t w = write(2, line, (size_t)n < sizeof(line) ? (size_t)n : sizeof(line) - 1u); (void)w; }
+}
+
+/* A page the game writes again and again (its display lists or vertices in VRAM: ~80 pages a frame, a fault each and
+ * then an mprotect each post) stays open once opened 3 times within 256 posts, reported at every post; every 256 posts all pages
+ * are closed again and the counts start over. */
+static uint8_t s_fm_vram_opened[4096];
+static unsigned s_fm_vram_posts;
+void sr_fastmem_vram_flush(void) {
+    const int decay = (++s_fm_vram_posts & 255u) == 0u;
+    for (unsigned w = 0; w < 64u; w++) {
+        uint64_t bits = atomic_load_explicit(&s_fm_vram_open[w], memory_order_acquire);
+        while (bits) {
+            const unsigned idx = w * 64u + (unsigned)__builtin_ctzll(bits);
+            bits &= bits - 1u;
+            const uint64_t k = idx >> 9, pg = idx & 511u;
+            sr_gpu_vram_dirty(0x04000000u + (uint32_t)pg * 4096u, 4096u);
+            if (s_fm_vram_opened[idx] < 255u) s_fm_vram_opened[idx]++;
+            if (!decay && s_fm_vram_opened[idx] >= 3u) continue;   /* hot: stays open */
+            const uint64_t at = SR_MEM_FIXED_ARENA + k * 0x20000000ull + 0x04000000u + pg * 4096u;
+            atomic_fetch_and_explicit(&s_fm_vram_open[w], ~(1ull << (idx & 63u)), memory_order_acq_rel);
+            if (mprotect((void *)(uintptr_t)at, 4096u, PROT_READ) != 0) {
+                fprintf(stderr, "fastmem: a VRAM page can't be closed again (0x%llx)\n", (unsigned long long)at);
+                abort();
+            }
+        }
+    }
+    if (decay) memset(s_fm_vram_opened, 0, sizeof(s_fm_vram_opened));
+}
+
+static void fm_handler(int sig, siginfo_t *si, void *ctx) {
+    ucontext_t *uc = (ucontext_t *)ctx;
+    const uint64_t fa = (uint64_t)(uintptr_t)si->si_addr;
+    const uint64_t pc = (uint64_t)uc->uc_mcontext.pc;
+    if (fa >= SR_MEM_FIXED_ARENA && fa < SR_MEM_FIXED_ARENA + 0x100000000ull) {
+        /* a store into plain VRAM (its read-only pages refuse only stores): the page opened, the store goes again */
+        const uint64_t g = fa - SR_MEM_FIXED_ARENA;
+        const uint32_t phys = (uint32_t)(g & 0x1FFFFFFFu), k = (uint32_t)(g >> 29);
+        if (phys >= 0x04000000u && phys < 0x04200000u && (phys & ~0xFFFu) != 0x04084000u) {
+            const unsigned idx = k * 512u + ((phys - 0x04000000u) >> 12);
+            const uint64_t bit = 1ull << (idx & 63u);
+            if (!(atomic_load_explicit(&s_fm_vram_open[idx >> 6], memory_order_relaxed) & bit)) {
+                const uint64_t at = SR_MEM_FIXED_ARENA + (uint64_t)k * 0x20000000ull + (phys & ~0xFFFu);
+                if (mprotect((void *)(uintptr_t)at, 4096u, PROT_READ | PROT_WRITE) == 0) {
+                    atomic_fetch_or_explicit(&s_fm_vram_open[idx >> 6], bit, memory_order_acq_rel);
+                    const unsigned long n = atomic_fetch_add_explicit(&s_fm_pages, 1ul, memory_order_relaxed) + 1ul;
+                    if ((n & (n - 1ul)) == 0ul) fm_say("VRAM pages opened for CPU stores:", n, 0u, pc, phys);
+                    return;
+                }
+            }
+        }
+    }
+    if (fa >= SR_MEM_FIXED_ARENA && fa < SR_MEM_FIXED_ARENA + 0x100000000ull + 64u) {
+        uint32_t insn;
+        memcpy(&insn, (const void *)(uintptr_t)pc, 4);
+        uint32_t ga = 0;
+        if (fm_emulate(uc, insn, &ga)) {
+            /* said at each power of two: a hot path through here shows in the log */
+            const unsigned long k = atomic_fetch_add_explicit(&s_fm_faults, 1ul, memory_order_relaxed) + 1ul;
+            if ((k & (k - 1ul)) == 0ul) fm_say("accesses run by the fault handler:", k, insn, pc, ga);
+            return;
+        }
+        fm_say("an access the fault handler does not decode, fault", 0ul, insn, pc, (uint32_t)(fa - SR_MEM_FIXED_ARENA));
+    }
+    const struct sigaction *prev = sig == SIGBUS ? &s_fm_prev_bus : &s_fm_prev_segv;
+    if ((prev->sa_flags & SA_SIGINFO) && prev->sa_sigaction) { prev->sa_sigaction(sig, si, ctx); return; }
+    if (prev->sa_handler != SIG_DFL && prev->sa_handler != SIG_IGN && prev->sa_handler) { prev->sa_handler(sig); return; }
+    signal(sig, SIG_DFL);   /* the instruction runs again and the default action ends the process */
+}
+
+/* The two views (recomp.h SR_FASTMEM); returns the host's view */
+static uint8_t *fm_map(void) {
+    const uint64_t G = SR_MEM_FIXED_ARENA, H = SR_HOST_VIEW;
+    const size_t phys = 0x0c010000u;   /* guest physical [0, 0x0c000000) and a 64 KiB guard past main RAM */
+    void *res = mmap((void *)(uintptr_t)G, (size_t)(H - G) + phys, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+    if (res != (void *)(uintptr_t)G) {
+        fprintf(stderr, "sr_mem_init: guest memory can't be reserved at 0x%llx (got %p)\n", (unsigned long long)G, res);
+        abort();
+    }
+    const int fd = memfd_create("deadstation-guest", MFD_CLOEXEC);
+    if (fd < 0 || ftruncate(fd, (off_t)phys) != 0) {
+        fprintf(stderr, "sr_mem_init: guest memory: memfd failed\n");
+        abort();
+    }
+#define FM_MAP(addr, len, prot, off) do { \
+        if (mmap((void *)(uintptr_t)(addr), (len), (prot), MAP_SHARED | MAP_FIXED, fd, (off_t)(off)) != (void *)(uintptr_t)(addr)) { \
+            fprintf(stderr, "sr_mem_init: guest memory: a view at 0x%llx failed\n", (unsigned long long)(addr)); abort(); } } while (0)
+    FM_MAP(H, phys, PROT_READ | PROT_WRITE, 0u);
+    for (uint64_t k = 0; k < 8u; k++) {
+        const uint64_t m = G + k * 0x20000000ull;
+        FM_MAP(m + 0x00010000u, 0x4000u, PROT_READ | PROT_WRITE, 0x00010000u);     /* scratchpad */
+        FM_MAP(m + 0x04000000u, 0x00200000u, PROT_READ, 0x04000000u);             /* VRAM: a CPU store faults */
+        if (mprotect((void *)(uintptr_t)(m + 0x04084000u), 0x1000u, PROT_NONE) != 0) {   /* the GE status word's page */
+            fprintf(stderr, "sr_mem_init: guest memory: mprotect failed\n");
+            abort();
+        }
+        FM_MAP(m + 0x08000000u, 0x04010000u, PROT_READ | PROT_WRITE, 0x08000000u);  /* main RAM and its guard */
+    }
+#undef FM_MAP
+    close(fd);
+    struct sigaction sa;
+    memset(&sa, 0, sizeof(sa));
+    sa.sa_sigaction = fm_handler;
+    sa.sa_flags = SA_SIGINFO;
+    sigemptyset(&sa.sa_mask);
+    if (sigaction(SIGSEGV, &sa, &s_fm_prev_segv) != 0 || sigaction(SIGBUS, &sa, &s_fm_prev_bus) != 0) {
+        fprintf(stderr, "sr_mem_init: guest memory: the fault handler can't be installed\n");
+        abort();
+    }
+    return (uint8_t *)(uintptr_t)H;
+}
